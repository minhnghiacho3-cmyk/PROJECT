            frame_slot = st.empty()
            info_slot = st.empty()

            if run:
                cap = cv2.VideoCapture(int(cam_index))
                if not cap.isOpened():
                    st.error("Không mở được webcam. Kiểm tra chỉ số camera hoặc quyền truy cập camera.")
                else:
                    try:
                        tm = cv2.TickMeter()
                        while True:
                            ok, frame = cap.read()
                            if not ok:
                                st.warning("Không đọc được khung hình từ webcam.")
                                break
                            tm.reset()
                            tm.start()
