def yolo_predict_and_draw(model, imgin, conf=0.25):
    """Giống predict.py: lấy xyxy + tên lớp, vẽ rectangle/putText màu xanh lá.
    Khác: nhận ảnh sẵn (BGR numpy) thay vì đọc từ file, và có ngưỡng conf."""
    results = model(imgin, conf=conf, verbose=False)
    out = imgin.copy()
    data_names, confs = [], []
    for result in results:
        xyxy = result.boxes.xyxy
        names = [result.names[cls.item()] for cls in result.boxes.cls.int()]
        confs_t = result.boxes.conf

        dataxy = xyxy.data.tolist()
        data_names = list(names)
        confs = confs_t.tolist()
        for i in range(len(dataxy)):
            obj1 = dataxy[i]
            pt1 = (int(obj1[0]), int(obj1[1]))
            pt2 = (int(obj1[2]), int(obj1[3]))
            cv2.rectangle(out, pt1, pt2, (0, 255, 0), 1)
            label = f"{data_names[i]} {confs[i]:.2f}"
            cv2.putText(out, label, (int(obj1[0]) - 10, int(obj1[1]) - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
    return out, data_names, confs

