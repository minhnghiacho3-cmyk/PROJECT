                            total_counts.update(c)
                            timeline.append({"Khung hình": frame_idx, **c})
                            processed += 1
                            progress.progress(processed / max_frames)
                            preview_slot.image(out_rgb, caption=f"Khung hình #{frame_idx}",
                                              use_container_width=True)
                        frame_idx += 1

                    cap.release()
                    os.unlink(tfile.name)

                    st.subheader(f"Đã xử lý {processed} khung hình (trong tổng {frame_idx} khung đã đọc)")
