FACE_NAMES = ["Khoa", "Kien", "Nghia", "Tin"]  # đúng thứ tự nhãn 0,1,2,3 của svc.pkl (như predict.py gốc)

def find_first_model(*filenames):
    for fn in filenames:
        path = find_model_file(fn)
