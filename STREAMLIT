def predict_eye(model, img_pil, threshold=30.0, diabetic_limit=0.3):
    """Giống predict_medical_precision trong notebook Kaggle.
    Ảnh giữ thang 0-255 (EfficientNet có sẵn bước chuẩn hoá bên trong model)."""
    arr = np.asarray(img_pil.convert("RGB").resize(EYE_IMG_SIZE, Image.BILINEAR), dtype=np.float32)
    probs = model.predict(np.expand_dims(arr, 0), verbose=0)[0]

    max_idx = int(np.argmax(probs))
    confidence = float(probs[max_idx]) * 100
    predicted = EYE_CLASSES[max_idx]
    prob_diabetic = float(probs[EYE_CLASSES.index("diabetic_retinopathy")])

    if prob_diabetic > diabetic_limit and predicted != "diabetic_retinopathy":
        status, text, conf = "warning", "Nghi ngờ bệnh võng mạc tiểu đường", prob_diabetic * 100
    elif confidence < threshold:
        status, text, conf = "uncertain", "Cần kiểm tra lại", confidence
    else:
        status, text, conf = "normal", EYE_VI[predicted], confidence
    return {"status": status, "text": text, "conf": conf, "top": predicted, "probs": probs}

