def yolo_predict_and_draw(model, img_rgb, conf):
    """Giống hệt luồng trong predict.py: lấy xyxy + tên lớp, vẽ rectangle/putText bằng cv2."""
    imgin = cv2.cvtColor(np.array(img_rgb), cv2.COLOR_RGB2BGR)
    results = model(imgin, conf=conf, verbose=False)
    result = results[0]

    xyxy = result.boxes.xyxy
    names = [result.names[cls.item()] for cls in result.boxes.cls.int()]
    confs = result.boxes.conf

    dataxy = xyxy.data.tolist()
    data_names = list(names)
    data_confs = confs.tolist()

    for i in range(len(dataxy)):
        obj1 = dataxy[i]
        pt1 = (int(obj1[0]), int(obj1[1]))
        pt2 = (int(obj1[2]), int(obj1[3]))
        cv2.rectangle(imgin, pt1, pt2, (0, 255, 0), 1)
        cv2.putText(imgin, data_names[i], (int(obj1[0]) - 10, int(obj1[1]) - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

    out_rgb = cv2.cvtColor(imgin, cv2.COLOR_BGR2RGB)
    table = [{"Lớp": n, "Confidence": round(float(c), 3)} for n, c in zip(data_names, data_confs)]
    return out_rgb, table

