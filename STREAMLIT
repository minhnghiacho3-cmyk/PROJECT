            return path
    return None

@st.cache_resource
def load_face_models():
    """Trả về ((detector, recognizer, svc), []) hoặc (None, [tên file còn thiếu])."""
    det_path = find_first_model("face_detection_yunet_2023mar.onnx")
    rec_path = find_first_model("face_recognition_sface_2021dec.onnx",
                                "face_recognition_sface_2021dec_1.onnx")
    svc_path = find_first_model("svc.pkl")
    missing = [name for name, path in [
        ("face_detection_yunet_2023mar.onnx", det_path),
        ("face_recognition_sface_2021dec.onnx", rec_path),
        ("svc.pkl", svc_path),
    ] if path is None]
    if missing:
        return None, missing
    detector = cv2.FaceDetectorYN.create(det_path, "", (320, 320), 0.9, 0.3, 5000)
    recognizer = cv2.FaceRecognizerSF.create(rec_path, "")
    svc = joblib.load(svc_path)
    return (detector, recognizer, svc), []

def recognize_faces(frame, models, score_thr=0.9, unknown_thr=0.5, max_faces=5,
                    show_box=True, show_conf=True, show_landmarks=False):
    """Nhận dạng tất cả khuôn mặt trong 1 khung hình BGR (ảnh / khung video / webcam).
    Luồng giống predict.py gốc: detect -> alignCrop -> feature -> SVC.
    Khác: dùng điểm lớn nhất của decision_function làm độ tin cậy (bản gốc so sánh cả mảng
    nên sẽ báo lỗi với SVC 4 lớp)."""
    detector, recognizer, svc = models
    h, w = frame.shape[:2]
    detector.setInputSize((w, h))
    detector.setScoreThreshold(float(score_thr))
    _, faces = detector.detect(frame)

    out = frame.copy()
    results = []
    if faces is None:
        return out, results

    faces = sorted(faces, key=lambda f: f[2] * f[3], reverse=True)[:int(max_faces)]
    for face in faces:
        feat = recognizer.feature(recognizer.alignCrop(frame, face))
        scores = svc.decision_function(feat)[0]
        best = int(np.argmax(scores))
        conf = float(scores[best])
        label_id = int(svc.classes_[best])
        if conf < unknown_thr or label_id >= len(FACE_NAMES):
            name, color = "unknown", (0, 0, 255)
        else:
            name, color = FACE_NAMES[label_id], (0, 255, 0)

        x, y, bw, bh = face[:4].astype(np.int32)
        if show_box:
            cv2.rectangle(out, (x, y), (x + bw, y + bh), color, 2)
        if show_landmarks:
            lm = face[4:14].astype(np.int32)
            for k, c in enumerate([(255, 0, 0), (0, 0, 255), (0, 255, 0), (255, 0, 255), (0, 255, 255)]):
                cv2.circle(out, (int(lm[2 * k]), int(lm[2 * k + 1])), 2, c, 2)
        label = f"{name} ({conf:.2f})" if show_conf else name
        cv2.putText(out, label, (int(x), max(int(y) - 10, 15)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
        results.append({"Tên": name, "Điểm SVC": round(conf, 3),
                        "Điểm phát hiện": round(float(face[-1]), 2)})
    return out, results

def process_face_video(video_path, models, params, sample_every=2, max_frames=150,
                       max_width=640, save_output=True, on_frame=None):
    """Nhận dạng khuôn mặt trên file video. Trả về dict thống kê (+ đường dẫn video kết quả)."""
    cap = cv2.VideoCapture(video_path)
    src_fps = cap.get(cv2.CAP_PROP_FPS) or 25.0
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
    writer, out_path = None, None
    counts = Counter()
    processed, frame_idx, frames_with_faces = 0, 0, 0
    while processed < max_frames:
        ok, frame = cap.read()
        if not ok:
            break
        if frame_idx % sample_every == 0:
            fh, fw = frame.shape[:2]
            if fw > max_width:
                frame = cv2.resize(frame, (max_width, int(fh * max_width / fw)))
            annotated, results = recognize_faces(frame, models, **params)
            names = {r["Tên"] for r in results}
            counts.update(names)
            frames_with_faces += 1 if results else 0
            if save_output:
                if writer is None:
                    out_path = tempfile.NamedTemporaryFile(delete=False, suffix=".mp4").name
                    writer = cv2.VideoWriter(
                        out_path, cv2.VideoWriter_fourcc(*"mp4v"),
                        max(1.0, src_fps / sample_every),
                        (annotated.shape[1], annotated.shape[0]))
                writer.write(annotated)
            processed += 1
            if on_frame:
                on_frame(annotated, processed, frame_idx, total, results)
        frame_idx += 1
    cap.release()
    if writer is not None:
        writer.release()
    return {"counts": counts, "processed": processed, "frames_read": frame_idx,
            "frames_with_faces": frames_with_faces, "out_path": out_path}

def to_browser_mp4(src_path):
    """mp4v (OpenCV) thường không phát được trên trình duyệt -> chuyển sang H.264 nếu có ffmpeg."""
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg or not src_path:
        return src_path, False
    dst = src_path.replace(".mp4", "_h264.mp4")
    r = subprocess.run([ffmpeg, "-y", "-i", src_path, "-vcodec", "libx264",
                        "-pix_fmt", "yuv420p", dst], capture_output=True)
    if r.returncode == 0 and os.path.exists(dst):
        return dst, True
    return src_path, False

