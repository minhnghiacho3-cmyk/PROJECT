                invert = st.checkbox("Đảo nhị phân (vật thể trắng trên nền đen)", False, key="mv_inv",
                                     disabled=not binarize)
            else:
                binarize = invert = False

        if mv_up is not None:
            pil = Image.open(mv_up).convert("RGB")
            img_bgr = cv2.cvtColor(np.array(pil), cv2.COLOR_RGB2BGR)
            if resize_on and max(img_bgr.shape[:2]) > max_side:
                s = max_side / max(img_bgr.shape[:2])
                img_bgr = cv2.resize(img_bgr, None, fx=s, fy=s, interpolation=cv2.INTER_AREA)
            h_img, w_img = img_bgr.shape[:2]
            st.image(cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB),
                     caption=f"Ảnh đầu vào ({w_img}x{h_img})", width=320)

            limit = {1: 400_000, 2: 100_000}.get(entry["slow"])
            if limit and h_img * w_img > limit:
                st.warning(f"Ảnh {w_img}x{h_img} khá lớn, hàm này có thể mất khá lâu. "
                           "Bật 'Thu nhỏ ảnh để chạy nhanh' trong phần tuỳ chọn nếu cần.")

            if st.button("▶️ Chạy", type="primary", key="mv_run"):
                with st.spinner(f"Đang chạy {func_name}..."):
                    try:
                        res = run_chapter_function(entry, img_bgr, binarize, invert)
                        res.update(chapter=chapter, func=func_name, error=None)
                        add_history("Thị giác máy", f"{chapter} - {func_name} ({res['elapsed']:.2f}s)")
                    except Exception as ex:
                        res = {"chapter": chapter, "func": func_name, "error": f"{type(ex).__name__}: {ex}"}
                st.session_state.mv_result = res

        res = st.session_state.get("mv_result")
        if res:
            st.divider()
            st.subheader(f"Kết quả gần nhất: {res['chapter']} • {res['func']}")
            if res["error"]:
                st.error(f"Lỗi khi chạy: {res['error']}")
                st.caption("Gợi ý: các hàm có điểm mồi/toạ độ cố định hoặc cần ảnh nhị phân phải dùng đúng ảnh mẫu của bài.")
            else:
                c1, c2 = st.columns(2)
                with c1:
                    mv_show(res["src"], "Đầu vào")
                with c2:
                    mv_show(res["out"], "Kết quả")

                m1, m2 = st.columns(2)
                m1.metric("Thời gian chạy", f"{res['elapsed']:.2f} s")
                if res["count"] is not None:
                    m2.metric("Số thành phần liên thông", res["count"])

                if res["log"].strip():
                    with st.expander("Nhật ký (print trong code chương)"):
                        st.code(res["log"])

                ok, png = cv2.imencode(".png", mv_to_uint8(res["out"]))
                if ok:
                    st.download_button("⬇️ Tải ảnh kết quả (PNG)", data=png.tobytes(),
                                       file_name=f"{res['func'].replace(' ', '_')}.png", mime="image/png")

