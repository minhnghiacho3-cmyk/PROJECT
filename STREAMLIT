def run_chapter_function(entry, img_bgr, binarize=False, invert=False):
    """Chạy 1 chức năng của chương. Ảnh màu hoặc ảnh xám tuỳ hàm (giống thigiacmay.py)."""
    if entry["color"]:
        src = img_bgr.copy()
    else:
        src = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)
        if binarize:
            flag = cv2.THRESH_BINARY_INV if invert else cv2.THRESH_BINARY
            _, src = cv2.threshold(src, 0, 255, flag + cv2.THRESH_OTSU)

    buf = io.StringIO()
    t0 = time.perf_counter()
    with contextlib.redirect_stdout(buf):      # gom các lệnh print() trong code chương
        out = entry["fn"](src.copy())
    elapsed = time.perf_counter() - t0

    n_comp = None
    if entry["count"]:
        o = np.asarray(out)
        if o.ndim == 3:
            o = cv2.cvtColor(o.astype(np.uint8), cv2.COLOR_BGR2GRAY)
        n_comp = int(cv2.connectedComponents((o > 0).astype(np.uint8))[0] - 1)
    return {"src": src, "out": out, "elapsed": elapsed, "log": buf.getvalue(), "count": n_comp}

def mv_to_uint8(arr):
    arr = np.asarray(arr)
    return arr if arr.dtype == np.uint8 else np.clip(arr, 0, 255).astype(np.uint8)

def mv_show(arr, caption):
    """Hiển thị ảnh BGR hoặc xám."""
