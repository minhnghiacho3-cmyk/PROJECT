# ---------- Shape (giữ nguyên thuật toán code gốc: tách nền + Hu moments) ----------
SHAPE_RANGES = {
    "circle":   (0.000623, 0.000625),
    "square":   (0.000646, 0.000655),
    "triangle": (0.00073,  0.00076),
}

def phan_nguong(imgin, tol=0):
    """Giống code gốc: pixel trùng màu nền (pixel [0,0]) -> 0, còn lại -> 255.
    Viết bằng numpy nên nhanh hơn vòng for, kết quả giống hệt khi tol = 0."""
    mau_nen = imgin[0, 0].astype(np.int16)
    diff = np.abs(imgin.astype(np.int16) - mau_nen).max(axis=2)
    return np.where(diff > tol, 255, 0).astype(np.uint8)

def nhan_dang_shape(imgout, ranges):
    """Moments -> Hu moments -> so Hu[0] với các khoảng ngưỡng (như code gốc)."""
    Hu = cv2.HuMoments(cv2.moments(imgout))
    h0 = float(Hu[0][0])
    for name, (lo, hi) in ranges.items():
        if lo < h0 < hi:
            return name, h0
    return "unknown", h0

